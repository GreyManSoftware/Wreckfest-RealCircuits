# Copy to .env (gitignored) for local Docker Compose secrets. Never commit real values.

# Shared secret the build worker sends as "Authorization: Bearer <secret>" to PATCH /api/internal/builds/{id}.
# Generate one with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Empty disables the endpoint.
TRACKGEN_WORKER_SECRET=

# Optional: pin the first-admin invite code instead of reading a random one from the API log.
# Must be 43 URL-safe base64 characters ([A-Za-z0-9_-]). Only used while no users exist.
TRACKGEN_BOOTSTRAP_ADMIN_CODE=
